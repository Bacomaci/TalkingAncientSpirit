# Copy this to .env and fill in your keys
ANTHROPIC_API_KEY=your_anthropic_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ElevenLabs voice ID for the spirit character (get from elevenlabs.io)
ELEVENLABS_VOICE_ID=your_voice_id_here

# For downloading large whisper models
HF_TOKEN=your_huggingface_token_here

# Whisper model size: tiny, base, small, medium, large-v2 (larger = more accurate, slower)
WHISPER_MODEL=base

# Whisper language code (e.g. hu, en, de) — speeds up transcription and improves accuracy
WHISPER_LANGUAGE=hu

# Fallback listen window in seconds (overridden per-spirit by listen_seconds in game_config.yaml)
LISTEN_SECONDS=10

# Language the spirit speaks (full name, e.g. Hungarian, English, German)
SPIRIT_LANGUAGE=Hungarian

# ElevenLabs TTS language code (e.g. hu, en, de) — sets the accent/pronunciation
# Note: requires eleven_turbo_v2_5 model (eleven_multilingual_v2 does not support language_code)
TTS_LANGUAGE_CODE=hu

# Audio device index (-1 = system default)
AUDIO_INPUT_DEVICE=-1
AUDIO_OUTPUT_DEVICE=-1
